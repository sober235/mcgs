__pycache__/
*.pyc
*.so
gaussian/cuda_ext/build/
paired_gs/gaussian/cuda_ext/build/
# data / weights / results — bring-your-own, never committed
*.mat
*.npy
*.pth
*.h5
results*/
outputs/
logs*/
paths.private.yaml
# assets are regenerated by scripts/ (see README); keep the dir, not the blobs
assets/*.mat

# CRISP experiment records: ignore bulky outputs but VERSION the JSON provenance
!results_crisp/
results_crisp/*
!results_crisp/*.json
!results_crisp/README.md
!results_crisp/FOLLOWUPS.md

# ARC inspection panels: ignore bulky outputs but VERSION the LOOK_* review figures
!results_arc/
results_arc/*
!results_arc/LOOK_*.png

# artefact-diagnosis records: ignore bulky outputs but VERSION the JSON readings
!results_arc/diag_artefact/
results_arc/diag_artefact/*
!results_arc/diag_artefact/*.json
