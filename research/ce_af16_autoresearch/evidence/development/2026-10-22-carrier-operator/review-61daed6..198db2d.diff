+def error_stats(actual, expected):
+    diff = (actual - expected).abs()
+    return {'maxabs': diff.max().item() if diff.numel() else 0.,
+            'maxrelative': (diff / expected.abs().clamp_min(2e-5)).max().item() if diff.numel() else 0.}
